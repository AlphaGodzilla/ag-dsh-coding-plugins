auto-install-peers=true
strict-peer-dependencies=false

# Publishing auth lives OUTSIDE this file on purpose:
# pnpm no longer expands ${VAR} in a repository-controlled .npmrc (security
# fix GHSA-3qhv-2rgh-x77r). CI publishes via actions/setup-node's
# `registry-url` input, which writes a user-level .npmrc, plus the
# NODE_AUTH_TOKEN env var (repo secret NPM_TOKEN). See .github/workflows/release.yml.
