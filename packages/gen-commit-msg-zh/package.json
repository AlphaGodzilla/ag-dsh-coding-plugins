{
  "name": "@ag-dsh/dsh-gen-commit-msg-zh",
  "description": "DeepSeek Harness (DSH) plugin: generate a Chinese git commit message and commit interactively (slash command + skill)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "agent",
    "git",
    "commit-message",
    "commit"
  ],
  "version": "1.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaGodzilla/ag-dsh-coding-plugins.git",
    "directory": "packages/gen-commit-msg-zh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "prompts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-commands": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-skill": "catalog:",
    "@deepseek-ai/dsh-user-questions": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-commands": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-skill": "catalog:",
    "@deepseek-ai/dsh-user-questions": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
